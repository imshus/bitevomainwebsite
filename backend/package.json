{
  "name": "bitevo-web-backend",
  "private": true,
  "version": "1.0.0",
  "description": "BiteVo customer website API (Node.js + Express + MongoDB). Shares its database with the admin panel.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js --port 4001",
    "start": "node src/server.js"
  },
  "nodemonConfig": {
    "watch": ["src", ".env"],
    "ext": "js,json",
    "delay": 300
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongodb": "^6.12.0",
    "nodemailer": "^6.9.16"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
