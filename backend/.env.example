# Copy to backend/.env and fill in. Never commit the real .env (it holds the database password).

# MongoDB connection: use the SAME database as the admin panel, so website orders show up there.
# Either one full URI...
MONGODB_URI=
# ...or the URL plus separate credentials (same format as the admin panel's .env):
MONGO_DB_URL=
MONGO_DB_USER=
MONGO_DB_PASSWORD=
# Database name (default: bitevo)
MONGO_DB_NAME=bitevo
# Without a connection string the API uses a local JSON file (data/db.json) with a starter menu.

# Port for the API (default 4001; the dev script always uses 4001).
PORT=4001

# The website's address(es), comma separated. Needed so the browser can send the sign-in cookie.
# https://bitevo.in and https://www.bitevo.in are always allowed as well.
CLIENT_ORIGIN=http://localhost:2002

# Where the admin panel's API serves uploaded menu photos (/uploads/...), e.g. https://api-admin.bitevo.in.
# Empty = same origin as the website (in development Vite forwards /uploads to the admin API on 4000).
ADMIN_PUBLIC_URL=

# Delivery charges (₹). DELIVERY_FEE=0: free delivery on every order. Above 0: free on each customer's first
# FREE_DELIVERY_ORDERS orders (cancelled ones don't count), then DELIVERY_FEE on every order.
DELIVERY_FEE=0
FREE_DELIVERY_ORDERS=3
MIN_ORDER_VALUE=99

# "Order more, save more" offers (₹; 0 switches one off). SIGNUP_BONUS goes into every new account's
# wallet; DELIVERY_CASHBACK into the wallet for every delivered order. A first order of FREE_COFFEE_FROM
# or more gets a free Cold Coffee (a dish with that name must be on the menu). One ₹1 store item can be
# added once the other items total STORE_UNLOCK_AT.
SIGNUP_BONUS=20
DELIVERY_CASHBACK=20
FREE_COFFEE_FROM=99
STORE_UNLOCK_AT=399

# Sign-in codes. OTP_DEV_MODE=true shows the code on screen and in this server's log instead of
# sending an SMS. Set it to false once MINIMOTH_API_KEY is set, to send real codes.
OTP_DEV_MODE=true

# Sign-in codes on WhatsApp or SMS through MiniMoth (minimoth.dev). Dashboard → your project → Settings →
# copy the API key (mm_live_…; an mm_test_… key sends nothing). No DLT registration needed: MiniMoth sends
# from its own sender. Set OTP_DEV_MODE=false to use it. Keep the key secret.
MINIMOTH_API_KEY=

# Cookies: use COOKIE_SECURE=true on HTTPS. If the website and API are on different domains,
# also set COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_DAYS=30

# Set to true when running behind a proxy/load balancer (so rate limits and IP addresses are right).
TRUST_PROXY=false

# Google Maps Platform (Places API (New), Geocoding API, Maps JavaScript API).
# GOOGLE_MAPS_KEY stays on the server. GOOGLE_MAPS_BROWSER_KEY draws the map in the browser: restrict it
# to your website domains in Google Cloud. Empty = uses GOOGLE_MAPS_KEY (fine on localhost).
# Without a key, addresses are typed in by hand as before.
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Optional: kitchen position and delivery radius. Addresses further away are refused. Empty = no check.
# (Ignored while DELIVERY_AREAS is set: the areas decide.)
KITCHEN_LAT=
KITCHEN_LNG=
DELIVERY_RADIUS_KM=

# Where we deliver: these areas (comma-separated) of DELIVERY_CITY. An address must name the city and one
# of the areas ("Sector 44" also matches "Sec 44" or "Sector-44"); everywhere else shows "Service
# unavailable" and can't order. Left out = Sector 40, 44 and 45 in Gurugram. Set but empty = no area rule.
DELIVERY_CITY=Gurugram
DELIVERY_AREAS=Sector 40, Sector 44, Sector 45

# Refer & earn: when a friend who signed up with a customer's code has REFERRAL_ORDERS orders delivered,
# that customer gets REFERRAL_REWARD (₹) in their wallet as cashback. REFERRAL_ENABLED=false hides it.
REFERRAL_ENABLED=true
REFERRAL_REWARD=100
REFERRAL_ORDERS=2

# "Continue with Google" on the sign-in sheet. Create an OAuth 2.0 Client ID (type "Web application") in
# Google Cloud → APIs & Services → Credentials, and add your site (e.g. https://bitevo.in and
# http://localhost:2002) under "Authorised JavaScript origins". Empty = the button is hidden.
GOOGLE_CLIENT_ID=
# Signs the 15-minute ticket used while a Google user adds their mobile number. Any long random text.
AUTH_SECRET=
# Public address of the website, for links in emails (defaults to the first CLIENT_ORIGIN).
SITE_URL=

# Emails to customers (welcome, order confirmations, sign-in codes) from your Hostinger mailbox.
# hPanel → Emails → your mailbox: SMTP server smtp.hostinger.com, port 465 (SSL). Empty SMTP_PASS = no emails.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BiteVo <hello@bitevo.in>

# Online payments (UPI, cards, netbanking) through Razorpay. Dashboard → Account & Settings → API keys.
# rzp_test_… keys take test payments only. Both set = "Pay online" at checkout; empty = cash/wallet only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Image uploads (POST /api/uploads) go to a public Supabase Storage bucket, the same one the admin panel
# saves menu photos to. Supabase → Project Settings → API keys: the project URL and a secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=bitevo-images
# Optional: lets a script or another server upload with an "x-upload-key" header (any long random text).
UPLOAD_API_KEY=
