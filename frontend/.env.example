# Copy to frontend/.env and adjust. Only variables starting with VITE_ reach the browser, so never put
# secrets in them.

# Address of the BiteVo website API. Empty = same origin: in development Vite forwards /api to
# API_PROXY_TARGET below. In production, if the API is on another domain, set it before
# `npm run build`, e.g. VITE_API_URL=https://api.bitevo.in
VITE_API_URL=

# Development and `npm run preview` only (vite.config.js): where Vite forwards API calls (/api) and the
# menu photos uploaded in the admin panel (/uploads).
API_PROXY_TARGET=http://localhost:4001
ADMIN_API_PROXY_TARGET=http://localhost:4000

# Usual delivery time in minutes, shown in the badge at the top of the menu.
VITE_DELIVERY_MINS=30
